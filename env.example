# MomentMind - 环境变量配置示例
# 请复制此文件为 .env 并填入您的实际配置值

# Azure OpenAI 统一密钥
AZURE_OPENAI_KEY=您的Azure统一Key

# Chat (GPT-5-mini 部署) - 用于灵感总结和AI对话
AZURE_OPENAI_ENDPOINT_CHAT=https://benja-mauryh2z-swedencentral.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-5-mini
AZURE_OPENAI_API_VERSION_CHAT=2024-12-01-preview

# Image (DALL-E-3 部署) - 用于图像生成
AZURE_OPENAI_ENDPOINT_IMAGE=https://feiyue1112.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_IMAGE=dall-e-3
AZURE_OPENAI_API_VERSION_IMAGE=2024-02-01

# 服务器配置
PORT=8787

# 开发模式设置
MOCK_OPENAI=0

# ================================
# 配置说明：
# ================================
# 
# 1. AZURE_OPENAI_KEY: 您的Azure OpenAI资源密钥
#    - 在Azure门户中的认知服务资源页面可以找到
#    
# 2. AZURE_OPENAI_ENDPOINT_CHAT: GPT模型的Azure端点
#    - 格式：https://您的资源名.cognitiveservices.azure.com/
#    
# 3. AZURE_OPENAI_DEPLOYMENT_CHAT: GPT模型的部署名称
#    - 在Azure OpenAI Studio中创建的部署名称
#    
# 4. AZURE_OPENAI_ENDPOINT_IMAGE: DALL-E模型的Azure端点
#    - 可能与Chat端点不同，取决于您的部署配置
#    
# 5. AZURE_OPENAI_DEPLOYMENT_IMAGE: DALL-E模型的部署名称
#    - 在Azure OpenAI Studio中创建的DALL-E-3部署名称
#
# 注意：请确保您的Azure订阅有足够的配额来使用GPT-5-mini和DALL-E-3
